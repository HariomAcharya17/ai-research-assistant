# Required for AI features (ranking, explanations, gaps, writing help).
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the Groq models
# GROQ_SMART_MODEL=openai/gpt-oss-120b
# GROQ_FAST_MODEL=openai/gpt-oss-20b

# Optional, all free. The app works without them.
# OpenAlex key raises the daily quota: https://openalex.org/settings/api
OPENALEX_API_KEY=
# Semantic Scholar key avoids the shared rate limit: https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=
# Springer Nature Meta API: https://dev.springernature.com/
SPRINGER_API_KEY=
# IEEE Xplore API: https://developer.ieee.org/
IEEE_API_KEY=
# Elsevier key, used only to check whether a journal is indexed in Scopus: https://dev.elsevier.com/
ELSEVIER_API_KEY=

# AI requests allowed per IP every 10 minutes
# AI_REQUESTS_PER_10_MIN=60
